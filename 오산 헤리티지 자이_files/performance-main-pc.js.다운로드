(function () {
  /* =====================================================================================
   * 기본 설정
   * ===================================================================================== */
  const PERFORMANCE_CONFIG = {
    // 전환 UI 선택
    sideFixed: true,
    sideToggle: false,
    bottomToggle: false,
    wingCategory: false,
    videoWing: false,
    assetBase: "https://cdn.adperson.kr/2026/os-heritagexi/performance-1/atype",
  };

  window.PerformancePcConfig = PERFORMANCE_CONFIG;

  /* =====================================================================================
   * 퍼포먼스 PC 본문 컴포넌트
   * ===================================================================================== */
  class SiteBodyPC extends HTMLElement {
    /* 초기 데이터 로드 및 화면 생성 */
    async connectedCallback() {
      if (this.dataset.rendered === "true") return;
      if (window.USE_PC !== true || window.USE_PERFORMANCE_PC !== true) return;

      const site = (await window.SiteData?.get?.())?.site || {};

      this.dataset.rendered = "true";
      document.documentElement.classList.add("performance-pc-mode");
      document.documentElement.classList.toggle(
        "performance-side-fixed-active",
        PERFORMANCE_CONFIG.sideFixed,
      );

      this.innerHTML = this.renderLayout(site);
      document.dispatchEvent(new Event("performance-pc-ready"));
    }

    asset(path) {
      return `${PERFORMANCE_CONFIG.assetBase}/${path}`;
    }

    /* DB카트 주소 및 iframe 생성 */
    renderDbcart(site, className) {
      return /* html */ `
        <div class="performance-dbcart ${className}">
          <iframe src="https://${site.dbcartId}.dbcart.net/?dbcartapi=1" title="방문예약 DB카트" height="600" scrolling="no" loading="lazy"></iframe>
        </div>
      `;
    }

    /* ===================================================================================
     * 화면 HTML
     * =================================================================================== */
    renderLayout(site) {
      /* 메인 */
      const mainHtml = /* html */ `
        <section class="performance-section performance-main logo-white" id="main">
          <img src="${this.asset("main/main-img.png")}" class="performance-img" alt="메인" />
          <img src="${this.asset("main/main-bg.jpg")}" class="performance-bg" alt="" />
        </section>
      `;

      /* 섹션 */
      const sectionsHtml = /* html */ `

        <!-- 혜택 -->
        <section class="performance-section" id="benefit">
          <img src="${this.asset("section/benefit.png")}" class="performance-img" alt="혜택" loading="lazy" />
          <img src="${this.asset("section/benefit-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 사업개요 -->
        <section class="performance-section" id="summary">
          <img src="${this.asset("section/summary.png")}" class="performance-img" alt="사업개요" loading="lazy" />
          <img src="${this.asset("section/summary-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 인테리어 -->
        <section class="performance-section" id="interior">
          <img src="${this.asset("section/interior.png")}" class="performance-img" alt="인테리어" loading="lazy" />
          <img src="${this.asset("section/interior-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 배너 01 -->
        <section class="performance-section">
          <img src="${this.asset("section/banner01.png")}" class="performance-img" alt="배너" loading="lazy" />
          <img src="${this.asset("section/banner-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 타입 -->
        <section class="performance-section" id="type">
          <img src="${this.asset("section/type.png")}" class="performance-img" alt="타입" loading="lazy" />
          <img src="${this.asset("section/type-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 입지 -->
        <section class="performance-section" id="location">
          <img src="${this.asset("section/location.png")}" class="performance-img" alt="입지환경" loading="lazy" />
          <img src="${this.asset("section/location-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 배너 02 -->
        <section class="performance-section">
          <img src="${this.asset("section/banner02.png")}" class="performance-img" alt="배너" loading="lazy" />
          <img src="${this.asset("section/banner-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 커뮤니티 -->
        <section class="performance-section" id="community">
          <img src="${this.asset("section/community.png")}" class="performance-img" alt="커뮤니티" loading="lazy" />
          <img src="${this.asset("section/community-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

         <!-- 배너 03 -->
        <section class="performance-section">
          <img src="${this.asset("section/banner03.png")}" class="performance-img" alt="배너" loading="lazy" />
          <img src="${this.asset("section/banner-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 단지배치도 -->
        <section class="performance-section" id="siteplan">
          <img src="${this.asset("section/siteplan.png")}" class="performance-img" alt="단지배치도" loading="lazy" />
          <img src="${this.asset("section/siteplan-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>

        <!-- 프리미엄 
        <section class="performance-section" id="premium">
          <img src="${this.asset("section/premium.png")}" class="performance-img" alt="프리미엄" loading="lazy" />
          <img src="${this.asset("section/premium-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>
        -->


        <!-- 하단 DB카트 
        <section class="performance-section performance-bottom-db" id="pc-bottom-db">
          <img src="${this.asset("section/db-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
          <div class="performance-bottom-db__inner">
            <img src="${this.asset("section/db-img.png")}" class="performance-bottom-db__title" alt="방문예약" loading="lazy" />
            ${this.renderDbcart(site, "performance-dbcart--bottom")}
          </div>
        </section>
        -->

        <!-- 영상 
        <section class="performance-section performance-video-section" id="video">
          <img src="${this.asset("section/video-section-img.png")}" class="performance-img" alt="홍보 영상" loading="lazy" />
          <video class="performance-section-video" autoplay muted loop playsinline controls>
            <source src="${this.asset("section/video-section.mp4")}" type="video/mp4" />
          </video>
          <img src="${this.asset("section/video-section-bg.jpg")}" class="performance-bg" alt="" loading="lazy" />
        </section>
        -->
      `;

      /*  TOP 버튼  */
      const topButtonHtml = /* html */ `
        <button type="button" class="performance-top-button" aria-label="페이지 상단으로 이동" data-action="performance-scroll-top">
          <span aria-hidden="true">↑</span>
          <small>TOP</small>
        </button>
      `;

      /* =================================================================================
       * 전환 UI
       * ================================================================================= */

      /* 사이드 토글 */
      const sideToggleHtml = PERFORMANCE_CONFIG.sideToggle
        ? /* html */ `
            <aside class="quick-sidebar" aria-label="방문예약 사이드 패널">
              <button class="quick-sidebar-toggle" type="button" aria-label="사이드 예약폼 열기" aria-expanded="false">
                <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
              </button>
              <div class="quick-sidebar-body" style="--quick-sidebar-bg:url('${this.asset("cta/side-toggle-bg.jpg")}');">
                <img class="quick-sidebar-visual" src="${this.asset("cta/side-toggle-img.png")}" alt="방문예약 안내" />
                ${this.renderDbcart(site, "performance-dbcart--side-toggle")}
              </div>
            </aside>
          `
        : "";

      /* 하단 토글 */
      const bottomToggleHtml = PERFORMANCE_CONFIG.bottomToggle
        ? /* html */ `
            <div class="pc-bottom-toggle-original">
              <div class="quick-bottom">
                <p class="quick-bottom-text">방문예약!</p>
                <button class="quick-bottom-btn" type="button" aria-expanded="false"><b>관심고객 등록</b>하기</button>
              </div>
              <div class="quick-popup" aria-hidden="true">
                <div class="quick-popup-inner" role="dialog" aria-modal="true" aria-label="관심고객 방문예약" style="background:url('${this.asset("cta/bottom-toggle-bg.jpg")}') center/cover no-repeat;">
                  <button class="quick-popup-close" type="button" aria-label="닫기">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                  </button>
                  <img src="${this.asset("cta/bottom-toggle-img.png")}" alt="방문예약" />
                  ${this.renderDbcart(site, "performance-dbcart--bottom-toggle")}
                </div>
              </div>
            </div>
          `
        : "";

      /* 카테고리 윙배너 */
      const wingCategoryHtml = PERFORMANCE_CONFIG.wingCategory
        ? /* html */ `
            <aside class="pc-bottom-wing" style="--pc-wing-bg:url('${this.asset("cta/wing-category-bg.png")}');" aria-label="빠른 메뉴">
              <button class="pc-bottom-wing__close" type="button" aria-label="닫기">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
              </button>
              <button class="pc-bottom-wing__badge" type="button" data-target="pc-bottom-db" aria-label="방문예약 폼으로 이동">
                <span class="pc-bottom-wing__badge-text"><span>관심고객</span><strong>방문예약</strong></span>
              </button>
              <ul class="pc-bottom-wing__nav">
                <li><a href="#location" data-target="location">입지환경</a></li>
                <li><a href="#premium" data-target="premium">프리미엄</a></li>
                <li><a href="#community" data-target="community">커뮤니티</a></li>
                <li><a href="#type" data-target="type">타입안내</a></li>
              </ul>
            </aside>
          `
        : "";

      /* 영상 윙배너 */
      const videoWingHtml = PERFORMANCE_CONFIG.videoWing
        ? /* html */ `
            <div class="video-wing-set">
              <div class="video-wing">
                <button class="video-wing-close" type="button" aria-label="영상 윙배너 닫기">
                  <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
                <video class="video-wing-video" src="${this.asset("cta/wing-video.mp4")}" autoplay muted loop playsinline></video>
                <img class="video-wing-frame" src="${this.asset("cta/wing-video-bg.png")}" alt="홍보영상 보기" />
              </div>
              <button class="video-wing-thumb" type="button" aria-label="홍보영상 다시 보기">
                <span class="video-wing-thumb__media">
                  <video class="video-wing-thumb__video" src="${this.asset("cta/wing-video.mp4")}" muted loop playsinline></video>
                  <span class="video-wing-thumb__shade"></span>
                  <span class="video-wing-thumb__play"><span class="material-symbols-outlined" aria-hidden="true">play_arrow</span></span>
                  <span class="video-wing-thumb__label">팝업보기</span>
                </span>
              </button>
            </div>
          `
        : "";

      const ctaHtml = `${sideToggleHtml}${bottomToggleHtml}${wingCategoryHtml}${videoWingHtml}`;

      /* 사이드 고정 */
      if (PERFORMANCE_CONFIG.sideFixed) {
        return /* html */ `
          <div id="wrap" class="performance-pc-wrap performance-layout-side-fixed">
            <main>
              ${mainHtml}
              <div class="performance-section-wrap">
                <div class="performance-section-left">${sectionsHtml}</div>
                <aside
                  class="performance-section-right"
                  id="pc-side-fixed-panel"
                  style="--performance-side-bg:url('${this.asset("cta/side-fixed-bg.jpg")}')"
                >
                  <div class="performance-side-content">
                    <!-- <img class="performance-side-visual" src="${this.asset("cta/side-fixed-img.jpg")}" alt="방문예약" /> -->
                    ${this.renderDbcart(site, "performance-dbcart--side")}
                  </div>
                </aside>
              </div>
            </main>
            ${ctaHtml}
            ${topButtonHtml}
          </div>
        `;
      }

      /* 기본형  */
      return /* html */ `
        <div id="wrap" class="performance-pc-wrap performance-layout-base">
          <main>
            ${mainHtml}
            ${sectionsHtml}
          </main>
          ${ctaHtml}
          ${topButtonHtml}
        </div>
      `;
    }
  }

  /* =====================================================================================
   * 커스텀 엘리먼트 등록
   * ===================================================================================== */
  if (!customElements.get("site-pc-body")) {
    customElements.define("site-pc-body", SiteBodyPC);
  }
})();
