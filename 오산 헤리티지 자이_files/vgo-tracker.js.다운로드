(function () {
  if (window.__vgoTrackerLoaded) return;
  window.__vgoTrackerLoaded = true;

  var scriptEl = document.currentScript;
  if (!scriptEl) {
    return;
  }

  var siteKey = scriptEl.getAttribute('data-site-key');
  if (!siteKey) {
    console.warn('[vgo] Missing data-site-key');
    return;
  }

  var sitePageKey = scriptEl.getAttribute('data-site-page');

  var apiEndpointAttr =
    scriptEl.getAttribute('data-api-endpoint') ||
    scriptEl.getAttribute('data-endpoint') ||
    scriptEl.getAttribute('data-api');
  var API_ENDPOINT =
    apiEndpointAttr ||
    (typeof window !== 'undefined' && window.__VGO_API_ENDPOINT) ||
    'https://api.vgoing.kr/v1/track';
  var VISITOR_KEY = 'vgo:visitor:' + siteKey;
  var SESSION_KEY = 'vgo:session:' + siteKey;
  var SESSION_TTL_MS = 30 * 60 * 1000;
  var BATCH_SIZE = 8;
  var FLUSH_INTERVAL_MS = 4000;
  var SAMPLE_RATE = Number(scriptEl.getAttribute('data-sample-rate') || '1') || 1;
  if (SAMPLE_RATE < 0 || SAMPLE_RATE > 1) SAMPLE_RATE = 1;
  var queue = [];
  var flushing = false;
  var flushTimer = null;
  var pageId = 'page_' + randomId();
  var startedAt = Date.now();
  var maxScroll = 0;
  var scrolled5Sent = false;
  var lastPageView = { path: null, ts: 0 };
  var exitSent = false;

  var BOT_REGEX =
    /(bot|crawl|spider|slurp|headless|phantom|selenium|playwright|puppeteer|preview|facebookexternalhit|discord|whatsapp|telegram|slackbot|curl|wget|httpclient)/i;

  function randomId() {
    return Math.random().toString(36).slice(2, 12);
  }

  function isBot() {
    try {
      var ua = navigator.userAgent || '';
      if (!ua) return false;
      if (navigator.webdriver) return true;
      return BOT_REGEX.test(ua);
    } catch (_) {
      return false;
    }
  }

  function setCookie(name, value, ttlMs) {
    try {
      var expires = '';
      if (ttlMs) {
        var d = new Date();
        d.setTime(d.getTime() + ttlMs);
        expires = '; expires=' + d.toUTCString();
      }
      document.cookie = name + '=' + value + expires + '; path=/; samesite=lax';
    } catch (_) {}
  }

  function getCookie(name) {
    try {
      var value = document.cookie
        .split(';')
        .map(function (c) {
          return c.trim();
        })
        .find(function (c) {
          return c.startsWith(name + '=');
        });
      return value ? value.split('=')[1] : null;
    } catch (_) {
      return null;
    }
  }

  function getVisitorId() {
    try {
      var cookieId = getCookie(VISITOR_KEY);
      if (cookieId) return cookieId;
      var stored = window.localStorage.getItem(VISITOR_KEY);
      var id = stored || 'vis_' + randomId();
      window.localStorage.setItem(VISITOR_KEY, id);
      setCookie(VISITOR_KEY, id, 365 * 24 * 60 * 60 * 1000);
      return id;
    } catch (_) {
      return 'vis_' + randomId();
    }
  }

  function getSession() {
    var now = Date.now();
    try {
      var cookie = getCookie(SESSION_KEY);
      if (cookie) {
        var parts = cookie.split('.');
        if (parts.length === 2) {
          var id = parts[0];
          var last = parseInt(parts[1], 10);
          if (id && last && now - last < SESSION_TTL_MS) {
            setCookie(SESSION_KEY, id + '.' + now, SESSION_TTL_MS);
            return id;
          }
        }
      }
      var raw = window.sessionStorage.getItem(SESSION_KEY);
      if (raw) {
        var parsed = JSON.parse(raw);
        if (parsed.id && parsed.last && now - parsed.last < SESSION_TTL_MS) {
          parsed.last = now;
          window.sessionStorage.setItem(SESSION_KEY, JSON.stringify(parsed));
          setCookie(SESSION_KEY, parsed.id + '.' + now, SESSION_TTL_MS);
          return parsed.id;
        }
      }
      var id = 'ses_' + randomId();
      var payload = { id: id, last: now };
      window.sessionStorage.setItem(SESSION_KEY, JSON.stringify(payload));
      setCookie(SESSION_KEY, id + '.' + now, SESSION_TTL_MS);
      return id;
    } catch (_) {
      return 'ses_' + randomId();
    }
  }

  function parseUtm(url) {
    var params = new URL(url).searchParams;
    return {
      utm_source: params.get('utm_source') || undefined,
      utm_medium: params.get('utm_medium') || undefined,
      utm_campaign: params.get('utm_campaign') || undefined,
      utm_term: params.get('utm_term') || undefined,
      utm_content: params.get('utm_content') || undefined,
    };
  }

  function truncate(str, max) {
    if (!str || typeof str !== 'string') return str;
    if (str.length <= max) return str;
    return str.slice(0, max);
  }

  function clampProperties(properties) {
    if (!properties || typeof properties !== 'object') return undefined;
    try {
      var json = JSON.stringify(properties);
      if (json.length <= 2000) return properties;
      return JSON.parse(json.slice(0, 2000));
    } catch (_) {
      return undefined;
    }
  }

  function resolveSitePage() {
    if (!sitePageKey) return null;
    try {
      var params = new URL(window.location.href).searchParams;
      var value = params.get(sitePageKey);
      if (value && String(value).trim()) return String(value).trim();
      return null;
    } catch (_) {
      return null;
    }
  }

  function buildPathWithSitePage(basePath, segment) {
    var normalizedBase = basePath === '/' ? '' : basePath.replace(/\/+$/, '');
    var cleanedSegment = String(segment || '').trim().replace(/^\/+/, '');
    var merged = normalizedBase + '/' + cleanedSegment;
    return merged.startsWith('/') ? merged : '/' + merged;
  }

  function resolvePathAndPageId() {
    var basePath = window.location.pathname;
    var sitePageVal = resolveSitePage();
    var finalPath = basePath;
    var finalPageId = pageId;
    if (sitePageVal) {
      finalPath = buildPathWithSitePage(basePath || '/', sitePageVal);
      finalPageId = finalPath;
    }
    return { path: finalPath || '/', sitePage: sitePageVal, pageId: finalPageId };
  }

  function getDeviceType() {
    var ua = navigator.userAgent || '';
    if (/Mobi|Android/i.test(ua)) return 'mobile';
    if (/Tablet|iPad/i.test(ua)) return 'tablet';
    return 'desktop';
  }

  function getBrowser() {
    var ua = navigator.userAgent || '';
    if (/Chrome/i.test(ua) && !/Edge|Edg/i.test(ua)) return 'chrome';
    if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) return 'safari';
    if (/Edg/i.test(ua)) return 'edge';
    if (/SamsungBrowser/i.test(ua)) return 'samsung internet';
    return 'other';
  }

  function getOs() {
    var ua = navigator.userAgent || '';
    var lowered = ua.toLowerCase();
    if (lowered.indexOf('android') >= 0) return 'android';
    if (lowered.indexOf('iphone') >= 0 || lowered.indexOf('ipad') >= 0 || lowered.indexOf('ipod') >= 0 || lowered.indexOf('ios') >= 0) return 'ios';
    if (lowered.indexOf('windows') >= 0) return 'windows';
    if (lowered.indexOf('mac os x') >= 0 || lowered.indexOf('macintosh') >= 0) return 'mac';
    if (lowered.indexOf('linux') >= 0) return 'linux';
    return 'other';
  }

  function collectCommon(eventType) {
    var resolved = resolvePathAndPageId();
    var url = truncate(window.location.href, 500);
    var referrer = truncate(document.referrer || undefined, 300);
    var refDomain = undefined;
    if (referrer) {
      try {
        refDomain = new URL(referrer).hostname;
      } catch (_) {}
    }
    var utm = parseUtm(url);
    return {
      eventType: eventType,
      timestamp: new Date().toISOString(),
      siteKey: siteKey,
      visitorId: getVisitorId(),
      sessionId: getSession(),
      pageId: resolved.pageId,
      url: url,
      path: resolved.path,
      sitePage: resolved.sitePage || undefined,
      query: truncate(window.location.search || undefined, 300),
      title: truncate(document.title, 120),
      referrer: referrer,
      referrerDomain: refDomain,
      utm: utm,
      deviceType: getDeviceType(),
      browser: getBrowser(),
      os: getOs(),
      userAgent: navigator.userAgent,
      scrollMaxPercent: Math.round(maxScroll * 100),
      scrolledOver5: maxScroll >= 0.05,
    };
  }

  function enqueue(body, options) {
    if (Math.random() > SAMPLE_RATE) return;
    queue.push({ body: body, options: options || {} });
    if (queue.length >= BATCH_SIZE) {
      flushQueue();
    } else if (!flushTimer) {
      flushTimer = setTimeout(flushQueue, FLUSH_INTERVAL_MS);
    }
  }

  function flushQueue() {
    if (flushing) return;
    flushing = true;
    if (flushTimer) {
      clearTimeout(flushTimer);
      flushTimer = null;
    }
    var batch = queue.splice(0, BATCH_SIZE);
    if (!batch.length) {
      flushing = false;
      return;
    }
    var payload = JSON.stringify({
      events: batch.map(function (item) {
        return item.body;
      }),
    });
    var useBeacon = batch.some(function (b) {
      return b.options && b.options.useBeacon;
    });
    var sent = false;
    if (useBeacon && navigator.sendBeacon) {
      sent = navigator.sendBeacon(API_ENDPOINT, payload);
    }
    if (!sent) {
      fetch(API_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: payload,
        keepalive: useBeacon,
        credentials: 'omit',
      }).catch(function () {});
    }
    flushing = false;
  }

  function trackPageView() {
    var now = Date.now();
    var resolved = resolvePathAndPageId();
    if (lastPageView.path === resolved.path && now - lastPageView.ts < 5000) {
      return;
    }
    lastPageView = { path: resolved.path, ts: now };
    if (isBot()) return;
    enqueue(collectCommon('page_view'));
  }

  function trackExit() {
    if (exitSent) return;
    exitSent = true;
    if (isBot()) return;
    var duration = Date.now() - startedAt;
    var body = collectCommon('page_exit');
    body.durationMs = duration;
    enqueue(body, { useBeacon: true });
  }

  function onScroll() {
    var scrollTop = window.scrollY || document.documentElement.scrollTop;
    var docHeight =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    if (docHeight <= 0) return;
    var percent = scrollTop / docHeight;
    if (percent > maxScroll) maxScroll = percent;
    if (!scrolled5Sent && maxScroll >= 0.05) {
      scrolled5Sent = true;
      if (!isBot()) {
        var body = collectCommon('scroll_5');
        body.scrollPercent = Math.round(maxScroll * 100);
        enqueue(body);
      }
    }
  }

  function onClick(e) {
    if (isBot()) return;
    if (!e || typeof e !== 'object') return;
    if (typeof e.button === 'number' && e.button !== 0) return;
    var target = e.target || null;
    var rect = target && target.getBoundingClientRect ? target.getBoundingClientRect() : null;
    var properties = {
      pageX: Math.round(e.pageX || 0),
      pageY: Math.round(e.pageY || 0),
      clientX: Math.round(e.clientX || 0),
      clientY: Math.round(e.clientY || 0),
      screenX: Math.round(e.screenX || 0),
      screenY: Math.round(e.screenY || 0),
      scrollX: Math.round(window.scrollX || window.pageXOffset || 0),
      scrollY: Math.round(window.scrollY || window.pageYOffset || 0),
      viewportWidth: Math.round(window.innerWidth || document.documentElement.clientWidth || 0),
      viewportHeight: Math.round(window.innerHeight || document.documentElement.clientHeight || 0),
      targetTag: target && target.tagName ? target.tagName.toLowerCase() : undefined,
      targetRole: target && target.getAttribute ? target.getAttribute('role') || undefined : undefined,
      targetDataId:
        target && target.getAttribute
          ? target.getAttribute('data-click-id') ||
            target.getAttribute('data-analytics-id') ||
            target.getAttribute('data-testid') ||
            undefined
          : undefined,
      bounding: rect
        ? {
            top: Math.round(rect.top),
            left: Math.round(rect.left),
            width: Math.round(rect.width),
            height: Math.round(rect.height),
          }
        : undefined,
    };
    var body = collectCommon('click');
    body.properties = clampProperties(properties);
    enqueue(body);
  }

  window.vgo = {
    track: function (eventType, properties) {
      if (isBot()) return;
      var body = collectCommon(eventType || 'custom');
      if (properties) body.properties = clampProperties(properties);
      enqueue(body);
    },
    trackConversion: function (properties) {
      if (isBot()) return;
      var body = collectCommon('conversion');
      if (properties) body.properties = clampProperties(properties);
      enqueue(body);
    },
  };

  document.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'hidden') {
      trackExit();
    }
  });
  document.addEventListener('click', onClick, { capture: true, passive: true });
  window.addEventListener('beforeunload', function () {
    trackExit();
    flushQueue();
  });

  trackPageView();
  flushTimer = setTimeout(flushQueue, FLUSH_INTERVAL_MS);
})();
