// 📌 모바일 헤더 코드
(function(){
  const MOBILE_BREAK = 990;

  const onReady = (fn) => {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, { once:true });
    else fn();
  };

  const findHeaderEl = () => document.querySelector('site-header .site-header') || document.querySelector('.site-header');

  function bindHeader(headerEl){
    if (!headerEl || headerEl.__hdrBound) return;
    headerEl.__hdrBound = true;

    const isMobile = () => window.innerWidth <= MOBILE_BREAK;

    // ------- PC: hover open/close + focusout 접근성 -------
    headerEl.addEventListener('mouseenter', ()=> headerEl.setAttribute('data-open','true'));
    headerEl.addEventListener('mouseleave', ()=> headerEl.removeAttribute('data-open'));
    headerEl.addEventListener('focusout', ()=> {
      setTimeout(()=> { if (!headerEl.contains(document.activeElement)) headerEl.removeAttribute('data-open'); }, 0);
    });

    // ------- 단일 클릭 위임으로 MO 햄버거 & .col 동작 처리 -------
    headerEl.addEventListener('click', (ev) => {
      // 햄버거 토글 (버튼 내부/자식 클릭 모두 처리)
      if (ev.target.closest('.menu_btn')) {
        if (!isMobile()) return;
        ev.preventDefault();
        headerEl.classList.toggle('open');
        return;
      }

      // mega 컬럼 관련: h4 > a 는 모바일에서 이동 막고 컬럼 토글
      const h4Link = ev.target.closest('.mega .col h4 > a');
      if (h4Link) {
        if (!isMobile()) return; // PC는 기본 동작
        ev.preventDefault(); ev.stopPropagation();
        const col = h4Link.closest('.mega .col');
        // 닫기 다른 컬럼
        headerEl.querySelectorAll('.mega .col').forEach(c => { if (c !== col) c.classList.remove('mo-open'); });
        col.classList.toggle('mo-open');
        return;
      }

      // 컬럼 내부 빈영역 클릭 -> 토글 (단, depth2 링크 클릭은 무시)
      const col = ev.target.closest('.mega .col');
      if (col) {
        if (!isMobile()) return;
        if (ev.target.closest('.depth2 a')) return; // 2뎁스 링크는 이동
        if (ev.target.closest('h4')) return;        // h4는 위에서 처리
        headerEl.querySelectorAll('.mega .col').forEach(c => { if (c !== col) c.classList.remove('mo-open'); });
        col.classList.toggle('mo-open');
      }
    });

    // ------- 단일 resize 처리: 모바일->데스크탑 전환에서 초기화 -------
    const onResize = () => {
      if (!isMobile()) {
        headerEl.classList.remove('open');
        headerEl.querySelectorAll('.mega .col.mo-open').forEach(c => c.classList.remove('mo-open'));
      }
    };
    window.addEventListener('resize', onResize);
  }

  // Try immediate bind, otherwise observe for 동적 렌더링 (웹컴포넌트 등)
  onReady(() => {
    const h = findHeaderEl();
    if (h) { bindHeader(h); return; }
    const mo = new MutationObserver((_, obs) => {
      const h2 = findHeaderEl();
      if (h2) { obs.disconnect(); bindHeader(h2); }
    });
    mo.observe(document.body, { childList:true, subtree:true });
  });
})();


