//  📌 언론보도
//  - li 클릭 시 .on 토글 (위임)
//  - span 비었으면 .news-title 텍스트 복사

(function(){
  // jQuery 위임 (기존 유지)
  $(document).on('click', '.news-board li', function () {
    $(this).toggleClass('on');
  });

  // span 비었으면 title 텍스트로 보정
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".news-board li").forEach(li => {
      const titleEl = li.querySelector(".news-title");
      const spanEl  = li.querySelector("span");
      if (!titleEl || !spanEl) return;

      const titleText = titleEl.textContent.trim();
      const spanText  = spanEl.textContent.trim();
      if (!spanText && titleText) spanEl.textContent = titleText;
    });
  });
})();


// ============================================================================================================
// 📌 공통 data-scroll 부드러운 스크롤 + 해시 복원
// - [data-scroll] 클릭 시: 현재 페이지면 scrollIntoView, 아니면 index.html로 이동
// - 페이지 로드 후 location.hash 있으면 해당 위치로 스크롤

(function(){
  document.addEventListener("click", (e) => {  // [data-scroll] 클릭 처리
    const btn = e.target.closest("[data-scroll]");
    if (!btn) return;

    e.preventDefault();
    const sel = btn.dataset.scroll;
    if (!sel) return;

    const targetEl = document.querySelector(sel);
    if (targetEl) {
      targetEl.scrollIntoView({ behavior: "smooth" });
    } else {
      const base = "/index.html"; // 프로젝트 경로 맞춰 필요 시 조정
      location.href = `${base}${sel}`;
    }
  });

  // 해시 복원 (index 도착 후)
  window.addEventListener("DOMContentLoaded", () => {
    if (!location.hash) return;
    const targetEl = document.querySelector(location.hash);
    if (!targetEl) return;
    setTimeout(() => targetEl.scrollIntoView({ behavior: "smooth" }), 1000);  // 지연값 
  });
})();



// ===================================================================================================================================
// 📌 모달 섹션(여러 동일 클래스 대응) / 트리거 / 트리거 존재 시 트리거로 열기 / 닫기버튼·배경·뒤로가기 버튼(안드로이드&IOS)
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".modal-section").forEach(section => {
    const modalWrap = section.querySelector(".modal-wrap");
    const closeBtn  = modalWrap?.querySelector(".modal-close");
    const trigger   = section.querySelector(".modal-trigger"); // ✅ 트리거

    if (!modalWrap || !closeBtn) return;

    // ✅ 트리거가 있으면 섹션 커서를 기본(default)로
    if (trigger) section.style.cursor = "default";

    const open  = () => !modalWrap.classList.contains("open") && (modalWrap.classList.add("open"), history.pushState({__modal:true}, ""));
    const close = () => modalWrap.classList.contains("open") && (modalWrap.classList.remove("open"), history.state?.__modal && history.back());

    // ✅ 섹션 클릭 → 트리거가 있으면 트리거로만 열기, 없으면 기존처럼 섹션 전체로 열기
    section.addEventListener("click", e => {
      if (trigger) {
        if (e.target.closest(".modal-trigger")) {
          e.stopPropagation();
          open();
        }
        // 트리거 외의 클릭은 무시
      } else {
        if (!modalWrap.contains(e.target)) open();
      }
    });

    closeBtn.addEventListener("click", e => { e.stopPropagation(); close(); });          // 닫기 버튼
    modalWrap.addEventListener("click", e => { if (e.target === modalWrap) close(); });  // 배경 클릭 시 닫기

    ["popstate","pagehide"].forEach(ev =>                                                // 뒤로가기(popstate) & iOS pagehide → 열려있으면 닫기
      window.addEventListener(ev, () => modalWrap.classList.remove("open"))
    );
  });
});

// ============================================================================================================
// 📌 하단 퀵버튼 모달(말풍선) / 특정 위치 모달 / 닫기버튼, 배경, 뒤로가기 버튼

document.addEventListener("DOMContentLoaded", () => {
  const bubble    = document.querySelector(".mo_quick_bottom_Bubble");
  const modalWrap = document.querySelector(".mo_quick_bottom_modal_wrap"); 
  const modal     = document.querySelector(".mo_quick_bottom_modal"); 
  const closeBtn  = document.querySelector(".mo_quick_bottom_modal_wrap_close");

  if (!(bubble && modalWrap && modal && closeBtn)) return;

  const open = () => {
    if (!modalWrap.classList.contains("open")) {
      modalWrap.classList.add("open");
      history.pushState({ __modal: true, key: "footer" }, "");  // 뒤로가기를 위한 히스토리 엔트리 추가
      setTimeout(() => closeBtn.focus?.(), 0); // 접근성: 최초 포커스 이동
    }
  };

  const close = () => {
    if (modalWrap.classList.contains("open")) {
      modalWrap.classList.remove("open");
      if (history.state && history.state.__modal) {  // 스택 되돌려서 popstate 누락 방지 (특히 iOS용)
        history.back();
      }
    }
  };
  
  bubble.addEventListener("click", open);  // 열기
  closeBtn.addEventListener("click", close);  // 닫기 버튼
  modalWrap.addEventListener("click", close);  // 배경 클릭 시 닫기
  modal.addEventListener("click", (e) => e.stopPropagation());  // 내부 컨텐츠 클릭은 닫힘 방지

  // 뒤로가기(popstate) 이벤트 → 열려 있으면 닫기
  window.addEventListener("popstate", () => {
    if (modalWrap.classList.contains("open")) {
      modalWrap.classList.remove("open");
    }
  });

  // iOS Safari 일부 케이스 보완 (앱 전환/뒤로가기 제스처)
  window.addEventListener("pagehide", () => {
    if (modalWrap.classList.contains("open")) {
      modalWrap.classList.remove("open");
    }
  });
});


