// 📌팝업 닫기
document.addEventListener('DOMContentLoaded', () => {
  const wrap = document.querySelector('.popup_wrap');
  if (!wrap) return;
  const popup = wrap.querySelector('.popup');
  const ul = popup?.querySelector('ul');

  // 배경 클릭 → 팝업랩 전체 숨김
  wrap.addEventListener('click', e => { if (e.target === wrap) wrap.style.display = 'none'; });

  // 팝업 내부 클릭 전파 차단
  popup?.addEventListener('click', e => e.stopPropagation());

  // li 닫기 버튼: 해당 li 숨김 → 남은 li 없으면 팝업랩 숨김
  popup?.querySelectorAll('.popup_close').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault(); e.stopPropagation();
      const li = btn.closest('li'); if (!li) return;
      li.style.display = 'none';
      const anyVisible = ul && Array.from(ul.children).some(c => c.offsetParent !== null && getComputedStyle(c).display !== 'none');
      if (!anyVisible) wrap.style.display = 'none';
    });
  });

  // "1일 동안 보지 않음" — 자정 기준(다음 자정까지)
  const skip = popup?.querySelector('.popup_skip_oneday');
  if (skip) {
    const until = Number(localStorage.getItem('popup_hide_until') || 0);
    if (until > Date.now()) { wrap.style.display = 'none'; return; }
    skip.addEventListener('click', e => {
      e.preventDefault(); e.stopPropagation();
      const now = new Date();
      const nextMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1); // 다음 자정 00:00
      localStorage.setItem('popup_hide_until', String(nextMidnight.getTime()));
      wrap.style.display = 'none';
    });
  }
});


