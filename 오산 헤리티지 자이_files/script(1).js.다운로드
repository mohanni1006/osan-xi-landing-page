// 📌 하단 롤링 슬라이드 (푸터 swiper)
document.addEventListener('DOMContentLoaded', () => {
  const SwiperBottomQuick = document.querySelector('.bottom-quick-banner');
  if (!SwiperBottomQuick || !window.Swiper) return;   // 요소나 라이브러리 없으면 종료
  if (SwiperBottomQuick.swiper) return;               // 이미 초기화 되었으면 중복 방지
  
  new Swiper(SwiperBottomQuick, {
    loop: true,
    slidesPerView: 1,
    spaceBetween: 0,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false 
    }
  });
});


