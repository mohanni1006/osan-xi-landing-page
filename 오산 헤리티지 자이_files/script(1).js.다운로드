// 📌 당겨보세요 풀 배너 (밀어서 영상)
(function () {
  const bind = () => {
    const wrap = document.querySelector(".pull-banner");
    if (!wrap || wrap.__pullBound) return false;
    wrap.__pullBound = true;

    const videoLayer = wrap.querySelector(".pull-video");
    const textLayer = wrap.querySelector(".pull-text");
    const badge = wrap.querySelector(".pull-badge");
    const arrow = wrap.querySelector(".pull-arrow");
    const closeBtn = wrap.querySelector(".pull-close");
    const muteBtn = wrap.querySelector(".pull-mute");
    const video = wrap.querySelector(".pull-video video");

    const THUMB_HEIGHT = wrap.offsetHeight || 200; // CSS 높이를 기준값으로
    const THRESHOLD = 70;
    let startX = 0,
      curX = 0,
      dragging = false,
      isOpen = false,
      muted = true;

    // 음소거 토글
    muteBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      muted = !muted;
      video.muted = muted;
      muteBtn.textContent = muted ? "🔇" : "🔊";
    });

    // 영상 비율에 맞춰 배너 높이 계산
    const getVideoHeight = () => {
      if (!video.videoWidth || !video.videoHeight) return null;
      return Math.round(
        (video.videoHeight / video.videoWidth) * wrap.clientWidth,
      );
    };

    const open = () => {
      isOpen = true;
      videoLayer.classList.add("open");
      textLayer.classList.add("hidden");
      badge.classList.add("hidden");
      arrow.classList.add("hidden");
      wrap.classList.remove("dragging", "grabbing");
      video.play();
      const h = getVideoHeight();
      if (h) wrap.style.height = h + "px";
    };

    const close = () => {
      isOpen = false;
      videoLayer.classList.remove("open");
      video.pause();
      video.currentTime = 0;
      wrap.style.height = THUMB_HEIGHT + "px";
      textLayer.classList.remove("hidden");
      setTimeout(() => {
        badge.classList.remove("hidden");
        arrow.classList.remove("hidden");
      }, 200);
    };

    closeBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      close();
    });

    const onStart = (x) => {
      if (isOpen) return;
      startX = x;
      curX = x;
      dragging = true;
      wrap.classList.add("grabbing", "dragging");
    };
    const onMove = (x) => {
      if (dragging && !isOpen) curX = x;
    };
    const onEnd = () => {
      if (!dragging || isOpen) return;
      dragging = false;
      wrap.classList.remove("grabbing", "dragging");
      if (startX - curX >= THRESHOLD) open(); // 왼쪽으로 THRESHOLD 이상 당기면 열림
    };

    wrap.addEventListener("touchstart", (e) => onStart(e.touches[0].clientX), {
      passive: true,
    });
    wrap.addEventListener("touchmove", (e) => onMove(e.touches[0].clientX), {
      passive: true,
    });
    wrap.addEventListener("touchend", onEnd);
    wrap.addEventListener("mousedown", (e) => onStart(e.clientX));
    window.addEventListener("mousemove", (e) => {
      if (dragging) onMove(e.clientX);
    });
    window.addEventListener("mouseup", onEnd);

    return true;
  };

  // site-mo-body가 웹컴포넌트라 늦게 그려지므로 렌더링 대기
  document.addEventListener("DOMContentLoaded", () => {
    if (bind()) return;
    const mo = new MutationObserver((_, obs) => {
      if (bind()) obs.disconnect();
    });
    mo.observe(document.body, { childList: true, subtree: true });
  });
})();


