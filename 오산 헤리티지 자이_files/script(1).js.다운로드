// 📌 Feather 아이콘 초기화
(function(){
  const replace = () => window.feather?.replace?.();

  document.addEventListener('DOMContentLoaded', replace);   // 동적 DOM 삽입 대응
  new MutationObserver(replace).observe(document.body, { childList: true, subtree: true });
})();


