// ======================================================================================================================================================================
// 📍 경로 유틸 (URL 처리 관련 , fetch 없이) // ↓ 여기서부터 건들지 X
// ======================================================================================================================================================================
  function toPath(href){
    try { return (new URL(href, location.origin)).pathname; }
    catch { return href; }
  }

  // 쿼리까지 포함하여 경로 키 생성 (정확한 매칭용)
  function toKey(href){
    try {
      const u = new URL(href, location.origin);
      return u.search ? (u.pathname + u.search) : u.pathname;
    } catch {
      return href;
    }
  }

  function flatten(nodes, acc=[]){
    for(const n of (nodes||[])){
      acc.push(n);
      if(n.children) flatten(n.children, acc);
    }
    return acc;
  }

  // 계층 슬러그 생성: [부모ids..., 내 id] => "a-b-c"
  function makeSlug(parents, node){
    return [...parents.map(p => p.id), node.id].join('-');
  }

// ===================================================================================
// 📍 href 자동 생성기
// - 트리를 순회하며 모든 노드에 href 자동 생성, href 직접 입력 시 덮어쓰지 않음
// ===================================================================================
  function buildHrefs(nodes, parents=[]){
    for(const n of (nodes||[])){
      if(!n.id){
        console.warn('[SiteData] node에 id가 없습니다:', n);
        continue;
      }
      // ✅ 수동 href 있으면 유지
      if(!n.href){
        const slug = makeSlug(parents, n);
        n.href = `${SUBPAGE_ENTRY}?id=${slug}`;
      }
      if(n.children && n.children.length){
        buildHrefs(n.children, [...parents, n]);
      }
    }
  }

// ===================================================================================
// 📍 현재 페이지 위치 찾기. 현재 location과 트리의 href를 정확히 매칭
// ===================================================================================
  function locateByPath(pathname, cats){
    const all = flatten(cats || categories);

    // 현재 문서의 key (쿼리 포함)
    let curKey;
    try {
      const cur = new URL(location.href);
      curKey = cur.search ? (cur.pathname + cur.search) : cur.pathname;
    } catch {
      curKey = pathname;
    }

    // 1차: 완전 일치 (pathname+search)
    let hit = all.find(n => toKey(n.href) === curKey);

    // 2차: fallback - .html 경로 기준 startsWith (검색/인덱스 페이지 등 대응)
    if(!hit){
      hit = all
        .filter(n => /\.html$/.test(n.href))
        .find(n => pathname.startsWith(
          (new URL(n.href, location.origin)).pathname.replace(/index\.html$/,'')
        ));
    }
    if(!hit) return null;

    function parentOf(child){
      function walk(nodes, parent=null){
        for(const n of (nodes||[])){
          if(n===child) return parent;
          const p = walk(n.children, n);
          if(p!==undefined) return p;
        }
        return undefined;
      }
      return walk(categories);
    }
    const chain=[]; let cur=hit;
    while(cur){ chain.unshift(cur); cur=parentOf(cur); }
    return { hit, chain };
  }


// ===================================================================================
// 📍 media 정규화 유틸 (type=html)
// - 데이터에서 { html: '...' } 만 써도 실행 시 { type:'html', html:'...' } 으로 자동 변경, blocks.media에도 동일 규칙 적용
// ===================================================================================
  function normalizeMediaShape(nodes){
    for (const n of (nodes || [])) {
      const norm = (media) => {
        if (media == null) return media;

        const list = Array.isArray(media) ? media : [media];  // 단일 미디어도 배열로 승격

        return list.map(item => {  // type="html"이 없는 경우에도 { html: '...' } 형태면 자동으로 type 붙이기
          if (item && typeof item === 'object' && !Array.isArray(item) &&
              ('html' in item) && !('type' in item)) {
            return { type: 'html', html: item.html };
          }
          return item;
        });
      };

      if (n.media)           n.media        = norm(n.media);
      if (n.blocks?.media)   n.blocks.media = norm(n.blocks.media);

      if (n.children?.length) normalizeMediaShape(n.children);
    }
  }

// ===================================================================================
// 📍 문서 로드 시 1회 href 자동 생성 + media 정규화(type=html)
// ===================================================================================
  (function init(){
    try {
      buildHrefs(categories);
      normalizeMediaShape(categories);
    } catch(e){
      console.error('[SiteData] 초기화 실패:', e);
    }
  })();



// ===================================================================================
// 📍 Sub-Top 컴포넌트 (상단 크럼·제목)
// - 현재 선택된 카테고리 체인으로 크럼(경로)과 타이틀을 렌더링
// ===================================================================================
(function SubTopBlock(){
  class SubTop extends HTMLElement{
    async connectedCallback(){
      // 루트 생성 (간단한 구조 분리)
      const root = document.createElement('div');
      root.className = 'subtop';
      this.appendChild(root);

      // categories는 site-data.js 내부에서 선언된 변수를 재사용
      const { categories } = await window.SiteData.get?.() || { categories: window?.SiteData?.data?.categories || categories };

      // active chain 유틸: 쿼리(id=) 우선, 아니면 locateByPath 사용
      const getActiveChain = (cats) => {
        const id = new URLSearchParams(location.search).get('id') || '';
        if (id) {
          const [catId, itemId, subId] = id.split('-');
          const d1 = (cats||[]).find(c => c.id === catId) || null;
          const d2 = d1 ? (d1.children||[]).find(x => x.id === itemId) : null;
          const d3 = d2 ? (d2.children||[]).find(x => x.id === subId) : null;
          return [d1,d2,d3].filter(Boolean);
        }
        const info = window.SiteData?.locateByPath?.(location.pathname, cats) || null;
        return info?.chain || [];
      };

      const chain = getActiveChain(categories);
      if (!chain.length) { this.remove(); return; }

      const current = chain[chain.length-1];
      const crumbs = chain.map(n => `<span class="crumb-item">${n.label}</span>`).join('<i class="crumb-sep" aria-hidden="true">›</i>');

      root.innerHTML = /*html*/`
        <div class="subtop-wrap">
          <div class="subtop-crumb" aria-label="경로">${crumbs}</div>
          <h1 class="subtop-title">${current.label}</h1>
          <p class="subtop-desc">오직 당신만을 위한 특별한 프리미엄, 기대를 넘어서는 특별한 시작</p>
        </div>
        <div class="subtop-img" aria-hidden="true"></div>
      `;
    }
  }
  if (!customElements.get('sub-top')) customElements.define('sub-top', SubTop);
})();



// ===================================================================================
// 📍 Sub-Nav 컴포넌트 (2·3뎁스 탭 내비게이션)
// - 현재 1뎁스 기준으로 2뎁스 탭(및 선택 시 3뎁스) 렌더링
// - 의존: window.SiteData.get(), window.SiteData.locateByPath(), window.SiteData.firstDeepHref (가능하면 제공)
// ===================================================================================
(function SubNavBlock(){
  class SubNav extends HTMLElement{
    async connectedCallback(){
      const { categories } = await window.SiteData.get();
      const idParam = new URL(location.href).searchParams.get('id');

      // firstDeepHref: SiteData에 있으면 사용, 없으면 로컬 재정의
      const firstDeepHref = window.SiteData?.firstDeepHref ?? function f(node){ if(!node) return '/'; if(node.children && node.children.length) return f(node.children[0]); return node.href || '/'; };

      // 현재 d1, d2 결정 (쿼리 우선, 아니면 경로 매칭)
      let d1 = null, d2 = null;
      if (idParam){
        const [catId, itemId] = idParam.split('-');
        d1 = (categories||[]).find(c => c.id === catId) || null;
        d2 = d1 ? (d1.children||[]).find(x => x.id === itemId) : null;
      } else {
        const info = window.SiteData.locateByPath(location.pathname, categories);
        if (info) [d1, d2] = info.chain;
      }
      if (!d1) { this.remove(); return; }

      const depth2List = d1.children || [];
      const depth3List = d2?.children || [];

      const html2 = `
        <nav class="subnav" aria-label="${d1.label} 하위 메뉴">
          <div class="tab">
            ${depth2List.map(x=>{
              const active = (d2 && x.id === d2.id);
              const href = (x.children && x.children.length) ? firstDeepHref(x) : x.href;
              return `<a class="tab-btn ${active ? 'active' : ''}" href="${href}" ${active ? 'aria-current="page"' : ''}>${x.label}</a>`;
            }).join('')}
          </div>
        </nav>`;

      const html3 = (depth3List.length ? `
        <nav class="subnav subnav--depth3" aria-label="${d2?.label || ''} 하위 메뉴">
          <div class="tab">
            ${depth3List.map(x=>{
              const isActive = (new URL(x.href, location.origin)).href === (new URL(location.href)).href;
              return `<a class="tab-btn ${isActive ? 'active' : ''}" href="${x.href}">${x.label}</a>`;
            }).join('')}
          </div>
        </nav>` : '');

      this.innerHTML = `<div class="subnav-wrap">${html2}${html3}</div>`;
    }
  }
  if (!customElements.get('sub-nav')) customElements.define('sub-nav', SubNav);
})();



// ===================================================================================
// 📍 Page-View 컴포넌트 (컨텐츠 렌더러)
// - `id` 쿼리로 카테고리 트리에서 노드를 찾아 블록/미디어를 렌더링
// ===================================================================================
(function SimplePageView(){
  const getId = ()=> new URLSearchParams(location.search).get('id') || '';

  function findNodeById(categories, id){
    if(!id) return null;
    const [catId, itemId, subId] = id.split('-');
    const d1 = (categories||[]).find(c => c.id === catId);
    if(!d1) return null;
    if(!itemId) return d1;
    const d2 = (d1.children||[]).find(x => x.id === itemId);
    if(!d2) return d1;
    if(!subId) return d2;
    return (d2.children||[]).find(x => x.id === subId) || d2;
  }

  // 단순 이스케이프 (이미지 src/alt 등에만 사용)
  const esc = (s)=> String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

  function renderMediaItem(m){
    if (m && typeof m === 'object' && m.type === 'html' && typeof m.html === 'string') {  // 1) 이미 HTML 블록(운영자 직접 작성) 형태라면 그대로 반환
      return m.html;
    }
    // 문자열이면 단순 이미지로 처리 (legacy)
    if (typeof m === 'string') {
      return `<figure class="media-block"><img class="media media--img" src="${esc(m)}" alt="" loading="lazy" decoding="async"></figure>`;
    }
    // 객체지만 html이 없다면 간단한 img 속성 사용 허용
    if (m && typeof m === 'object' && m.src) {
      return `<figure class="media-block"><img class="media media--img" src="${esc(m.src)}" alt="${esc(m.alt||'')}" loading="lazy" decoding="async"></figure>`;
    }
    return '';
  }

  function renderStack(media = []){
    return `<main class="container"><div class="media-stack">${(media || []).map(renderMediaItem).join('')}</div></main>`;
  }

  class PageView extends HTMLElement{
    async connectedCallback(){  //웹컴포넌트가 연결되면 pv-wrap라는 빈 div를 만들고 자신(<page-view>)의 자식으로 넣음
      const wrap = document.createElement('div');
      wrap.className = 'pv-wrap';
      this.appendChild(wrap);

      // SiteData에서 categories, site 가져오기
      const { categories, site } = await (window.SiteData?.get?.() || Promise.resolve({ categories: window.SiteData?.data?.categories || [], site: {} }));
      // 현재 URL의 id 얻고, 트리에서 해당 노드 찾기
      const id = getId();
      const node = findNodeById(categories, id);

      // 노드가 없으면 에러(알림) 렌더링 후 종료
      if (!node){
        wrap.innerHTML = `<main class="container">
                            <h1>콘텐츠를 찾을 수 없어요</h1>
                            <p class="muted">잘못된 주소이거나 콘텐츠가 설정되지 않았습니다.</p>
                          </main>`;
        return;
      }

      // 노드에서 media가 배열(또는 단일)이라고 가정. 안정적으로 배열로 만들어 주기 위한 방어 코드
      const media = Array.isArray(node.media) ? node.media : (node.media ? [node.media] : []);
      wrap.innerHTML = renderStack(media, site);
    }
  }

  if (!customElements.get('page-view')) customElements.define('page-view', PageView);  //이미 page-view가 등록되어 있지 않다면(중복 정의 방지) 등록. 안전장치
})();


// ===================================================================================
// 📍 카테고리 외부 노출 API / enable="true" or "false"
// - get() : site + categories 반환
// - locateByPath / toPath / toKey / data 를 window.SiteData에 등록
// ===================================================================================
  async function get(){ 
    function filterEnabled(nodes){
      return (nodes||[])
        .filter(n => n.enable !== "false")   // ✅ 모든 depth 에 적용
        .map(n => ({ ...n, children: filterEnabled(n.children) }));
    }
    return { categories: filterEnabled(categories), site };
  }

  window.SiteData = { get, locateByPath, toPath, toKey, data:{ categories, site } };
})();