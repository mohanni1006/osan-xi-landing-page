// ========================= <site-header> =========================

class SiteHeader extends HTMLElement{
  async connectedCallback(){
    const { categories, site } = await window.SiteData.get();

    // ✅ 자식이 있으면 첫번째 자식 href, 자식의 자식까지 고려
    const firstDeepHref = (node) => {
      if (!node) return '/';
      if (node.children && node.children.length) {
        return firstDeepHref(node.children[0]); // 재귀적으로 가장 첫 자식까지 탐색
      }
      return node.href || '/';
    };

    this.innerHTML = /* html */`
      <header class="site-header" role="banner" style="opacity:0">
        <div class="gnb">
          <!-- ================================================================= 🔖로고 ================================================================= -->
          <a class="logo" href="/">
            <img class="header-logo-color" src="/img/logo-color.png" alt="헤더로고-컬러">
            <img class="header-logo-white" src="/img/logo-white.png" alt="헤더로고-화이트">
          </a>

          <!-- ================================================== 📑카테고리(site-data.js에서 자동 생성) ================================================== -->
          <nav class="nav" aria-label="주요 카테고리">
            ${categories.map(c => {
              // ✅ 1뎁스: 첫 번째 2뎁스(또는 3뎁스) 기준으로 링크 생성
              const firstChild = c.children && c.children.length ? c.children[0] : null;
              const href = firstDeepHref(c);

              // 첫 번째 자식 노드(target 여부 확인)
              const target = firstChild && firstChild.target ? `target="${firstChild.target}" rel="noopener"` : '';

              return `<a href="${href}" data-id="${c.id}" ${target}>${c.label}</a>`;
            }).join('')}
          </nav>

          <!-- ============================================================ 🎵PC용 BGM 버튼 ============================================================ -->
          <button class="bgm-toggle" data-action="toggle">
            <i data-feather="music"></i>
            <i data-feather="volume-x"></i>
          </button>
          <audio id="bgm-player" class="bgm-player" src="assets-pc/img/pc-bgm.mp3" loop></audio>

          <!-- =============================================================== 📞대표번호 =============================================================== -->
          <a class="number" href="tel:${site.tel}">
            <p class="pc"><i data-feather="phone"></i>${site.tel}</p>
            <img class="header-tel mo" src="img/quick/mo-header-tel.gif" alt="모바일 헤더 텔버튼">
          </a>
          <button aria-label="메뉴오픈" title="메뉴" class="menu_btn"><div></div><div></div><div></div></button>
        </div>

        <!-- ================================================================ 📑메가메뉴 ================================================================ -->
        <div class="mega-wrap" id="mega">
          <div class="mega">
            <div class="inner" style="grid-template-columns:repeat(${Math.max(1,categories.length)},minmax(0,1fr))">
              ${categories.map(c=>`
                <section class="col" data-col="${c.id}">
                  <h4><a href="${firstDeepHref(c)}">${c.label}</a></h4>
                  <ul class="depth2">
                    ${(c.children||[]).map(d2=>{
                      // ✅ 2뎁스: children이 있으면 첫 3뎁스로, 없으면 자기 자신
                      const href = (d2.children && d2.children.length) 
                        ? firstDeepHref(d2) 
                        : d2.href;
                      return `
                        <li>
                          <a href="${href}" ${d2.target ? `target="${d2.target}" rel="noopener"` : ''}>${d2.label}</a>
                          ${(d2.children&&d2.children.length)?`
                            <ul class="depth3">
                              ${d2.children.map(d3=>`<li><a href="${d3.href}" ${d3.target ? `target="${d3.target}" rel="noopener"` : ''}>${d3.label}</a></li>`).join('')}
                            </ul>`:''}
                        </li>`;
                    }).join('')}
                  </ul>
                </section>`).join('')}
            </div>
          </div>

        <!-- ========================================================== 📌 MO 전용 메뉴 리스트 ========================================================== -->
          <ul class="mo_gnb">
            <li class="m_number">
              <a href="tel:${site.tel}" class="dynamicNumber">${site.tel}</a>
            </li>
            <li class="m_registration">
              <a href="/?id=registration-registration">관심고객등록</a>
            </li>
            <li class="menu_btn" id="menu_btn_close">
              <span>메뉴닫기</span>
            </li>
          </ul>
        </div>

        <!-- ============================================================ 📌 MO 탑 퀵버튼 ============================================================ -->
        <div class="mo_quick_top" style="display:${site.moTopQuick}" data-scroll="#db_box" onclick="document.querySelector(this.dataset.scroll)?.scrollIntoView({behavior:'smooth'})">
          <div class="mo-quick-top-img">  
            <img src="img/quick/mo-quick-top.gif" alt="모바일 상단 퀵버튼">
          </div>
        </div>

        <div class="header-bg"></div>
      </header>
    `;


    // =========================================================================================
    // 후처리: 아이콘 치환 (feather)
    try { window.feather?.replace?.(); } catch(e){ /* 안전하게 무시 */ }


    // 활성 1뎁스 강조 (active클래스 추가, ?id=cat-item 기반)
    const idParam = new URL(location.href).searchParams.get('id') || '';
    const activeTop = idParam.split('-')[0];
    if(activeTop){
      this.querySelectorAll('.nav a').forEach(a=>{
        a.classList.toggle('active', a.dataset.id === activeTop);
      });
    }


  }
}
customElements.define('site-header', SiteHeader);
