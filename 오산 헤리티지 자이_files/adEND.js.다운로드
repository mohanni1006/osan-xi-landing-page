// ======================= INIT ==========================
  function bootAdEnd() {
    document.body.appendChild(document.createElement("ad-end"));
    document.addEventListener("input", (e) => {
      if (e.target?.id === "phone") {
        let v = e.target.value.replace(/[^0-9]/g, "");
        if (v.length > 3 && v.length <= 7) v = v.replace(/(\d{3})(\d+)/, "$1-$2");
        else if (v.length > 7) v = v.replace(/(\d{3})(\d{3,4})(\d{4})/, "$1-$2-$3");
        e.target.value = v;
      }
    });
  }

  if (document.readyState === "loading") {
    window.addEventListener("DOMContentLoaded", bootAdEnd);
  } else {
    bootAdEnd();
  }


