// ======================= SEND ==========================
async function validateAndSend() {
  const form = document.getElementById("myForm");
  const agree = document.getElementById("agree");
  const phone = document.getElementById("phone").value.trim();

  if (!/^01[0-9]-?\d{3,4}-?\d{4}$/.test(phone)) {
    alert("연락처 형식이 올바르지 않습니다.");
    return;
  }

  if (!agree.checked) {
    alert("개인정보취급방침에 동의해야 제출할 수 있습니다.");
    return;
  }

  const { site } = await window.SiteData.get();
  const rawNumber = site.consultantNumber?.replace(/[^0-9]/g, "");
  const C = CONSULTANT_MAP[rawNumber] ||
    CONSULTANT_MAP[site.consultantNumber] || {
      name: "default",
      team: "",
      noTel: true,
    };

  const consultantTel =
    !C.noTel && site.consultantNumber
      ? site.consultantNumber
      : COMPANY_MAIN_TEL;

  const formData = {
    ...Object.fromEntries(new FormData(form).entries()),
    host: location.hostname,
    siteName: site.siteName || "",
    consultant_phone: consultantTel,
    consultant_name: C.name || "",
    team: C.team || "",
  };

  console.log("consultantTel", consultantTel);
  console.log("formData", formData);

  fetch("https://server.adperson.kr/api/public/ad-end/lead", {
    method: "POST",
    mode: "no-cors",
    headers: {
      "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
    },
    body: new URLSearchParams(formData).toString(),
  });

  fetch(
    "https://script.google.com/macros/s/AKfycbwHPqVrB0i7L7wja_pyLj_NuTAfLc-qR-fPI2quqfWkR4BkFHqxzOrn-8pWi3-711gizg/exec",
    {
      method: "POST",
      mode: "no-cors",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        ...Object.fromEntries(new FormData(form).entries()),

        action: "form",
        siteName: site.siteName || "",

        consultantName: C.name,
        consultantNumber: site.consultantNumber || "",
        consultantTeam: C.team || "",

        source: "adEND",
      }),
    },
  );

  alert("상담 요청이 정상적으로 접수되었습니다.");
  form.reset();
  agree.checked = false;
}

// ======================= 전화문의  ==========================
let CALL_LOCK = false; // 🔒 연타 방지

document.addEventListener("click", async (e) => {
  const btn = e.target.closest("button");
  if (!btn) return;
  if (!btn.innerHTML.includes("call")) return;

  if (CALL_LOCK) return;
  CALL_LOCK = true;
  setTimeout(() => (CALL_LOCK = false), 1500);

  e.preventDefault();

  /* 테스트중
    // 📱 모바일에서만 전화문의 집계
    if (!/Android|iPhone/i.test(navigator.userAgent)) {
      // PC에서는 로그 없이 바로 전화만 시도
      const tel = btn.getAttribute("onclick")?.match(/tel:([^']+)/)?.[1];
      if (tel) location.href = `tel:${tel}`;
      return;
    }
      */

  try {
    const { site } = await window.SiteData.get();
    const rawNumber = site.consultantNumber?.replace(/[^0-9]/g, "");
    const C = CONSULTANT_MAP[rawNumber] ||
      CONSULTANT_MAP[site.consultantNumber] || {
        name: "default",
        team: "",
        noTel: true,
      };

    const tel =
      !C.noTel && site.consultantNumber
        ? site.consultantNumber
        : COMPANY_MAIN_TEL;

    fetch(
      "https://script.google.com/macros/s/AKfycbwHPqVrB0i7L7wja_pyLj_NuTAfLc-qR-fPI2quqfWkR4BkFHqxzOrn-8pWi3-711gizg/exec",
      {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "call",
          tel,
          siteName: site.siteName || "",
          consultant: C.name,
          consultantNumber: tel,
          team: C.team || "",
          source: "adEND", // 유입 예방
        }),
      },
    );

    location.href = `tel:${tel}`;
  } catch (err) {
    console.error("전화문의 로그 실패", err);
  }
});

// ======================= TAB 제어 ==========================
document.addEventListener("keydown", (e) => {
  if (e.key !== "Tab") return;

  const wrap = document.querySelector(".adEND-wrap.ad-end-img-open");
  if (!wrap) return;

  const right = wrap.querySelector(".right");
  if (!right) return;

  const focusable = right.querySelectorAll(
    "input, textarea, button, [tabindex]:not([tabindex='-1'])",
  );

  const list = Array.from(focusable).filter((el) => !el.disabled);
  if (!list.length) return;

  const index = list.indexOf(document.activeElement);
  let next = e.shiftKey ? index - 1 : index + 1;

  if (next >= list.length) next = 0;
  if (next < 0) next = list.length - 1;

  list[next].focus();
  e.preventDefault();
});
