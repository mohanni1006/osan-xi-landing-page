/* ===================================================================================
📄 sub-page.js
- 단일 index.html 환경에서 "메인"과 "서브 페이지"를 전환 제어하는 컴포넌트
- 메인에서는 <site-body>, <site-pc-body> 노출
- 서브에서는 <site-sub-page> 안에 <sub-top> / <sub-nav> / <page-view> 렌더
- 별도 라우터 없이 URL의 id 파라미터 기반으로 상태 전환
=================================================================================== */

class SiteSubPage extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    // ===================================================================================
    // 📌 1️⃣ 관련 엘리먼트 캐싱
    // - 메인 콘텐츠(<site-body>, <site-pc-body>)를 미리 찾음
    // ===================================================================================
    const siteBody = document.querySelector('site-body');
    const sitePcBody = document.querySelector('site-pc-body');


    // ===================================================================================
    // 📌 2️⃣ 메인/서브 상태 업데이트 함수
    // - 현재 URL의 ?id 파라미터 유무로 상태 판별
    // - 메인일 경우: site-body / site-pc-body 표시, sub-page 숨김
    // - 서브일 경우: site-body / site-pc-body 숨김, sub-page 표시 및 내부 렌더링
    // ===================================================================================
    const updateView = () => {
      const idParam = new URL(location.href).searchParams.get('id');
      const isSubPage = !!idParam;

      // ✅ 서브 페이지인 경우
      if (isSubPage) {
        siteBody?.setAttribute('hidden', '');
        sitePcBody?.setAttribute('hidden', '');
        this.removeAttribute('hidden');

        // 🧩 최초 1회만 sub-top / sub-nav / page-view 삽입
        if (!this.hasChildNodes()) {
          this.innerHTML = `
            <sub-top></sub-top>
            <sub-nav></sub-nav>
            <page-view></page-view>
          `;
        }
      }

      // ✅ 메인 페이지로 돌아온 경우
      else {
        this.setAttribute('hidden', '');
        siteBody?.removeAttribute('hidden');
        sitePcBody?.removeAttribute('hidden');
      }
    };


    // ===================================================================================
    // 📌 3️⃣ 초기 렌더링
    // - DOMContentLoaded 이후 바로 호출되어 첫 상태를 확정
    // - HTML 렌더 전에 실행되므로 깜빡임(flash) 방지
    // ===================================================================================
    updateView();
    document.documentElement.classList.add('ready'); // => body visibility:hidden 방지 플래그


    // ===================================================================================
    // 📌 4️⃣ 브라우저 네비게이션 대응
    // - 뒤로가기 / 앞으로가기 시에도 상태 자동 갱신
    // ===================================================================================
    window.addEventListener('popstate', updateView);


    // ===================================================================================
    // 📌 5️⃣ 내부 링크 클릭 처리
    // - 동일 도메인 내에서 ?id= 파라미터가 포함된 링크를 클릭하면
    //   ➜ 완전 새로고침 방식으로 이동 (SPA 라우팅 아님)
    // ===================================================================================
    document.body.addEventListener('click', (e) => {
      const a = e.target.closest('a[href]');
      if (!a) return;

      const url = new URL(a.href, location.origin);
      if (url.origin !== location.origin) return; // 외부 링크는 무시

      if (url.searchParams.has('id')) {
        e.preventDefault();
        location.href = url.href; // 완전 새로고침으로 이동
      }
    });
  }
}


// ===================================================================================
// 📌 6️⃣ 커스텀 엘리먼트 등록
// - HTML 내에서 <site-sub-page></site-sub-page> 사용 가능
// ===================================================================================
customElements.define('site-sub-page', SiteSubPage);
